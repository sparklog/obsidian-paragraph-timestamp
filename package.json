{
  "name": "obsidian-paragraph-timestamp",
  "version": "1.0.0",
  "description": "Obsidian plugin that inserts a timestamp at the start of every new Markdown paragraph.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "node --experimental-strip-types --experimental-detect-module --test test/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "timestamp",
    "markdown",
    "paragraph"
  ],
  "author": "tungliang",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
